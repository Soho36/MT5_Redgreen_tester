   Print("│ RED-RUN BAND FILTER                                        │");
   Print("├────────────────────────────────────────────────────────────┤");
   Print("│ Min consecutive reds: ", (MinRedRun < 1 ? 1 : MinRedRun));
   Print("│ Max consecutive reds: ", (MaxRedRun > 0 ? (string)MaxRedRun : "no cap"));
   Print("└────────────────────────────────────────────────────────────┘");

   // Display location filter
   Print("┌────────────────────────────────────────────────────────────┐");
   Print("│ LOCATION FILTER                                            │");
   Print("├────────────────────────────────────────────────────────────┤");
